DB_URL=jdbc:postgresql://localhost:5432/uptodate_db
DB_USERNAME=uptodate
DB_PASSWORD=replace-with-a-long-random-password
# Supply these only to the one-shot migration job, not the running web process.
DB_MIGRATION_USERNAME=uptodate_migrator
DB_MIGRATION_PASSWORD=replace-with-a-different-long-random-password

TWELVE_DATA_API_KEY=replace-me
ALERTS_EMAIL_ENABLED=false
ALERTS_EMAIL_TIME_ZONE=Europe/Brussels
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000

# Local defaults. In production use the prod profile, HTTPS, SMTP, and require
# verification before allowing authenticated actions.
SPRING_PROFILES_ACTIVE=
REQUIRE_HTTPS=false
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_HTTPS_PORT=443
SESSION_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_RESEND_COOLDOWN_MINUTES=15
MAX_JSON_BODY_BYTES=65536

# Production only. Set this to the exact address/subnet of the reverse proxy.
# A same-host Nginx proxy can use: 127\.0\.0\.1|::1
TRUSTED_PROXY_IP_REGEX=127\.0\.0\.1|::1
SERVER_BIND_ADDRESS=127.0.0.1
FLYWAY_ENABLED=false

ALERTS_MAX_TRACKED_STOCKS_PER_USER=50
ALERTS_MAX_GLOBAL_TRACKED_STOCKS=500
ALERT_SCHEDULE_ENABLED=true

# Distributed coordination and bounded provider latency. PostgreSQL stores the
# shared cooldowns, rate-limit counters, quote cache, and durable alert jobs.
MARKET_DATA_SYNC_LEASE_SECONDS=900
MARKET_DATA_CONNECT_TIMEOUT_SECONDS=10
MARKET_DATA_READ_TIMEOUT_SECONDS=30
ALERT_JOB_LEASE_SECONDS=1200
ALERT_RETRY_DELAY_SECONDS=60
ALERT_MAXIMUM_ATTEMPTS=3
ALERT_RECOVERY_DELAY_MS=60000
ALERT_RECOVERY_INITIAL_DELAY_MS=5000
ALERT_CATCH_UP_BATCH_SIZE=100
ALERT_INITIAL_SCHEDULE_LOOKBACK_DAYS=370
